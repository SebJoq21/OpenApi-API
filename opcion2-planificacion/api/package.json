{
  "name": "fogoneria-ordenes-api",
  "version": "1.0.0",
  "private": true,
  "description": "Implementación SDD del API de gestión de órdenes — Opción 2",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "dotenv -e .env -- ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:contract": "jest --config test/jest-contract.json --runInBand",
    "test:all": "npm run test:prepare && npm test && npm run test:e2e && npm run test:contract",
    "test:prepare": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "dotenv -e .env -- ts-node prisma/seed.ts",
    "token": "dotenv -e .env -- ts-node scripts/dev-token.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:local:init": "powershell -ExecutionPolicy Bypass -File scripts/db-local.ps1 init",
    "db:local:start": "powershell -ExecutionPolicy Bypass -File scripts/db-local.ps1 start",
    "db:local:stop": "powershell -ExecutionPolicy Bypass -File scripts/db-local.ps1 stop",
    "db:local:status": "powershell -ExecutionPolicy Bypass -File scripts/db-local.ps1 status",
    "openapi:lint": "npx @redocly/cli lint ../../openapi.yaml"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "jest-openapi": "^0.14.2",
    "prisma": "^6.16.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
